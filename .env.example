# ---------------------------------------------------------------------------
# Browser-visible configuration only.
# Anything prefixed with VITE_ is bundled into the client and is PUBLIC.
# Never put the site password, the service-role key, or any other secret here.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=https://rurhyjlyvkayzuwbbxoi.supabase.co

# Supabase "anon" / publishable key. Safe to expose: RLS is what protects data.
VITE_SUPABASE_ANON_KEY=sb_publishable_l8zzSR617mpzV7h_I5051w_80-TBOrW

# Where the auth session is kept in the browser.
#   local   - survives closing the tab (default, nicer on mobile)
#   session - cleared when the tab closes (stricter)
VITE_SESSION_PERSISTENCE=local

# Optional: conversation title shown in the chat header.
VITE_CHAT_TITLE=Our Chat
